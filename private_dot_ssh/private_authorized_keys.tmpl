{{ $orig := "" -}}
{{ $keys := list -}}
{{ $pth := (joinPath .chezmoi.homeDir ".ssh/authorized_keys") -}}
{{ if stat $pth }}{{ $orig = (include $pth | trim) }}{{ end -}}
{{ if eq 0 (len $orig) }}{{ $orig = "#" }}{{ end -}}

{{- with (index . "ssh") }}
  {{- with (index . "authorized_keys") }}
    {{- range . }}
      {{- $keys = append $keys . }}
    {{- end }}
  {{- end }}
{{- end }}

{{- /* [data.ssh].github_keys = false pins this host to the listed keys, so a
       key added to the GitHub account no longer reaches it on the next apply.
       Defaults to true because fresh boxes bootstrap from the GitHub keys. */ -}}
{{- $useGitHub := true -}}
{{- with (index . "ssh") }}{{ if hasKey . "github_keys" }}{{ $useGitHub = .github_keys }}{{ end }}{{ end -}}

{{- with (index . "user") }}
  {{- with (and $useGitHub (index . "github")) }}
    {{- range (gitHubKeys .) }}
      {{- $keys = append $keys .Key }}
    {{- end }}
  {{- end }}
{{- end -}}

{{ if ne 0 (len $keys) }}{{ range $keys }}{{ . }}
{{ end }}{{ else }}{{ $orig }}
{{ end -}}
