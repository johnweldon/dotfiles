# shellcheck disable=SC1054,SC1083,SC1009,SC1073,SC1065,SC1064,SC1072 # Contains Go template syntax
# ~/.bash_env - single source of truth for PATH and environment.
# Sourced by ~/.profile (login shells) and ~/.bashrc (interactive shells,
# and sshd-spawned one-shot `ssh host cmd` -- bash routes those through
# ~/.bashrc, so the source line there sits above the interactive guard).
# Keep POSIX-sh compatible, idempotent, and silent (no output).

# Idempotence guard: ~/.profile and ~/.bashrc both source this file, so a login
# interactive shell (every tmux window) would otherwise run all of it twice,
# including ~/.local.bash_env and its brew lookups.
[ -n "${__BASH_ENV_LOADED:-}" ] && return
__BASH_ENV_LOADED=1

_prepend_path() {
  case ":${PATH}:" in
  *:"$1":*) ;;
  *) [ -d "$1" ] && PATH="$1:${PATH}" ;;
  esac
}
_prepend_path "/usr/local/go/bin"
_prepend_path "${HOME}/go/bin"
_prepend_path "${HOME}/bin"
_prepend_path "${HOME}/.local/bin"
unset -f _prepend_path
export PATH

# uv-managed PATH additions
# shellcheck disable=SC1090,SC1091
[ -f "${HOME}/.local/bin/env" ] && . "${HOME}/.local/bin/env"

{{- /* en_US.UTF-8 unless this Linux host lacks it, as minimal images do,
       where C.UTF-8 avoids bash's setlocale warning on every shell. Decided at
       apply time, so a host that generates the locale later needs a reapply. */ -}}
{{- $lang := "en_US.UTF-8" -}}
{{- if and (eq .chezmoi.os "linux") (lookPath "locale") -}}
{{-   if not (output "locale" "-a" | regexMatch "(?im)^en_US\\.utf-?8$") -}}
{{-     $lang = "C.UTF-8" -}}
{{-   end -}}
{{- end }}
# LANG, not LC_ALL: LC_ALL overrides every category and ssh's default
# `SendEnv LC_*` would push it to hosts that may not have the locale.
export LANG="{{ $lang }}"
unset LC_ALL
# macOS Terminal sets LC_CTYPE=UTF-8, which is not a locale name on Linux, and
# ssh forwards it. Exporting LC_ALL used to mask that.
if [ "${LC_CTYPE:-}" = "UTF-8" ]; then
  LC_CTYPE="{{ $lang }}"
  export LC_CTYPE
fi
export LESSCHARSET='UTF-8'
export LESS='-FeX2Rgmwz-2'
export PAGER=less
{{ with (index . "user") }}{{ with (index . "tz") }}export TZ='{{ . }}'
{{ end }}{{ end }}
export EDITOR=vi VISUAL=vi
command -v vim >/dev/null 2>&1 && {
  EDITOR=vim
  VISUAL=vim
}
command -v nvim >/dev/null 2>&1 && {
  EDITOR=nvim
  VISUAL=nvim
}
export EDITOR VISUAL
{{- if eq .chezmoi.os "linux" }}

# Use the systemd user ssh-agent (ssh-agent.socket) unless the current
# SSH_AUTH_SOCK is a live socket, such as a forwarded agent. Hosts without that
# unit fall back to the agent ~/.bashrc starts.
if [ ! -S "${SSH_AUTH_SOCK:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/openssh_agent" ]; then
  SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/openssh_agent"
  export SSH_AUTH_SOCK
fi
{{- end }}

# machine-local env overrides (not chezmoi-managed; keep at mode 0600 -- it may
# hold secrets). Sourced last so it can override anything above.
# shellcheck disable=SC1090,SC1091
[ -f "${HOME}/.local.bash_env" ] && . "${HOME}/.local.bash_env"
