#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091
[ -f "${HOME}/.profile" ] && . "${HOME}/.profile"

# shellcheck disable=SC1090,SC1091
[ -f "${HOME}/.bashrc" ] && . "${HOME}/.bashrc"

# SSH logins get their own security session with the login keychain locked;
# unlock once so gog, op, git signing etc. can read their tokens.
if [ "$(uname -s)" = Darwin ] && [ -n "${SSH_CONNECTION:-}" ] &&
  case $- in *i*) true ;; *) false ;; esac && [ -t 0 ] &&
  ! security show-keychain-info login.keychain-db >/dev/null 2>&1; then
  security unlock-keychain login.keychain-db
fi

if command -v cleanpath > /dev/null 2>&1 ; then
  PATH=$(cleanpath -separator ':' "${PATH}")
  export PATH
fi
