#!/usr/bin/env bash
#
# Replace the Go toolchain at $(go env GOROOT) with a release from go.dev,
# verifying its published SHA-256 first. The previous tree stays beside it as
# $(dirname GOROOT)/<old version> so it can be moved back by hand.
#
# usage: update-go go1.27.5

set -euo pipefail

new_version="${1:?missing new go version, e.g. go1.27.5}"

if ! sudo -n true; then
  echo "sudo is not configured to allow running commands without a password"
  exit 1
fi

go_root=$(go env GOROOT)
go_version=$(go env GOVERSION)
go_hostarch=$(go env GOHOSTARCH)
go_hostos=$(go env GOHOSTOS)

for v in go_root go_version go_hostarch go_hostos; do
  if [ -z "${!v}" ]; then
    echo "${v} is empty" >&2
    exit 1
  fi
done

if [ "${go_version}" = "${new_version}" ]; then
  echo "already at ${new_version}"
  exit 0
fi

bakdir="$(dirname "${go_root}")/${go_version}"
if [ -e "${bakdir}" ]; then
  echo "${bakdir} already exists; move it aside first" >&2
  exit 1
fi

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

tmpdir=$(mktemp -d)
trap 'rm -rf "${tmpdir}"' EXIT

tarball="${new_version}.${go_hostos}-${go_hostarch}.tar.gz"
url="https://dl.google.com/go/${tarball}"

echo "Downloading ${url}"
curl -fsSL -o "${tmpdir}/${tarball}" "${url}"
want=$(curl -fsSL "${url}.sha256")
got=$(sha256 "${tmpdir}/${tarball}")
if [ "${got}" != "${want}" ]; then
  echo "checksum mismatch for ${tarball}: got ${got}, want ${want}" >&2
  exit 1
fi
tar -C "${tmpdir}" -xzf "${tmpdir}/${tarball}"

echo "Swapping ${go_version} -> ${new_version} at ${go_root}"
sudo mv "${go_root}" "${bakdir}"
if ! sudo mv "${tmpdir}/go" "${go_root}"; then
  # A cross-filesystem mv copies, so a failure can leave a partial tree.
  echo "install failed; restoring ${go_version}" >&2
  sudo rm -rf "${go_root}"
  sudo mv "${bakdir}" "${go_root}"
  exit 1
fi

"${go_root}/bin/go" version
echo "previous toolchain kept at ${bakdir}"
