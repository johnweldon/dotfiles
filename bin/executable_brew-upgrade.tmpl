{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# shellcheck disable=SC1054,SC1083 # Contains Go template syntax
set -euo pipefail

BREW_PREFIX=""
BREW_CMD=""
for pfx in "/opt/homebrew" "/usr/local"; do
  BREW_CMD="${pfx}/bin/brew"
  if [ -x "${BREW_CMD}" ]; then
    BREW_PREFIX="${pfx}"
    break
  fi
done

note() { printf '\033[1;33m%s\033[0;39m\n' "$*"; }

for subcmd in update "upgrade --greedy"; do
  note "brew ${subcmd}"
  # shellcheck disable=SC2086
  "${BREW_CMD}" ${subcmd}
done

# tailscale runs as a root system daemon (sudo brew services), which chowns its
# keg bin to root:admin. Two consequences after an upgrade:
#   1. the launchd plist points at the opt/ symlink, so the daemon keeps running
#      the old binary until restarted
#   2. brew cleanup can't remove the root-owned old kegs, and fails hard on them
# Restart first, then remove: the live daemon is executing out of the old keg.
# This runs before cleanup so cleanup has nothing left it can't delete.
tailscale_fixup() {
  local ts_cellar="${BREW_PREFIX}/Cellar/tailscale"
  local ts_bin="${BREW_PREFIX}/bin/tailscale"
  local current daemon keg reply
  local -a stale=()

  [ -d "${ts_cellar}" ] || return 0

  current="$(basename "$(readlink "${BREW_PREFIX}/opt/tailscale")")"
  daemon="$("${ts_bin}" version --daemon 2>/dev/null | awk '/^Daemon:/ {print $2}' || true)"
  daemon="${daemon%%-*}"

  if [ -z "${daemon}" ]; then
    note "tailscale daemon not responding, skipping restart"
  elif [ "${daemon}" != "${current}" ]; then
    note "restarting tailscale daemon (sudo): ${daemon} -> ${current}"
    sudo brew services restart tailscale
  fi

  for keg in "${ts_cellar}"/*; do
    [ -d "${keg}" ] || continue
    [ "$(basename "${keg}")" = "${current}" ] && continue
    stale+=("${keg}")
  done

  [ "${#stale[@]}" -gt 0 ] || return 0

  note "stale tailscale kegs to remove (sudo):"
  printf '  %s\n' "${stale[@]}"
  if [ ! -t 0 ]; then
    note "not a tty, leaving them in place"
    return 0
  fi
  read -r -p "remove? [y/N] " reply || reply=""
  case "${reply}" in
  [yY]*) sudo rm -rf "${stale[@]}" ;;
  *)
    note "left in place"
    return 0
    ;;
  esac

  daemon="$("${ts_bin}" version --daemon 2>/dev/null | awk '/^Daemon:/ {print $2}' || true)"
  note "tailscale verified: keg ${current}, daemon ${daemon:-unknown}"
}

tailscale_fixup || note "tailscale fixup failed, continuing"

# Still tolerate a cleanup failure: the fixup leaves stale kegs in place when
# it can't prompt or the answer was no, and other formulae can hit the same
# root-owned-keg problem.
note "brew cleanup"
"${BREW_CMD}" cleanup || note "brew cleanup reported errors, continuing"
{{- end }}
