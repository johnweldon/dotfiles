#!/usr/bin/env bash
#
# User specific aliases and functions
#

# ls Aliases

if command ls --help 2>&1 | grep -q -- --color; then
  alias ls='\ls --color=auto -F'
else
  alias ls='\ls -CFG'
fi

alias la='ls -a'
alias ll='ls -l'
alias lat='ls -lat'
alias latr='ls -latr'
alias lathr='ls -lathr'

# MISC Aliases

# shellcheck disable=SC2154
alias where='for ix in "${!DIRSTACK[@]}"; do echo "${DIRSTACK[$ix]}"; done'

# An alias, not +short in ~/.digrc: as a global default it renders NXDOMAIN and
# NOERROR-with-no-record identically as empty output.
alias digs='dig +short'
alias dps="docker ps --format '{{ printf \"%-30s %-20s %s\" .Names .Status .Ports }}'"
alias emacs='emacs -nw'
# jw4/jot (C) defaults to a bare dated file in the CURRENT directory; this
# restores the old ~/bin/jot behaviour of a dated note under ~/notes. Note -r is
# concatenated with the filename rather than path-joined, so the trailing slash
# on the default is required.
alias jot='jot -d -r "${NOTES_DIR:-$HOME/notes/}" -s .md'
alias k='kubectl'
alias python='python3'
alias tf='terraform'
alias tmux='tmux -2u'
