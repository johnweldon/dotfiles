{{- with (index . "user") -}}
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}{{ with (index . "gpg_key_id") }}
	signingkey = {{ . | quote }}

[gpg]
	format = ssh

[commit]
	gpgsign = true{{ end }}

{{ end -}}
[core]
	excludesfile = ~/.local.gitignore
	ignorecase = false{{ if lookPath "delta" }}
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true{{ end }}

[branch]
	sort = -committerdate

[commit]
	verbose = true

[init]
	defaultBranch = main

[tag]
	sort = version:refname

[fetch]
	prune = true
	writeCommitGraph = true

[pull]
	ff = only
	rebase = true

[push]
	default = simple
	autoSetupRemote = true
	followtags = true

[apply]
	whitespace = fix

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[rebase]
	autoStash = true

[diff]
	algorithm = histogram
	colorMoved = default
	submodule = log

[diff "pdf"]
	textconv = pdftostdout

# Covers fetch.fsckObjects and receive.fsckObjects, which fall back to it.
[transfer]
	fsckobjects = true

[status]
	submoduleSummary = true

[submodule]
	recurse = true

[log]
	date = iso

[format]
	pretty = %C(cyan)%G? %Creset%C(auto)%h%Creset %C(auto)%D%Creset %s %C(dim cyan)(%cr)%Creset %C(dim green)%aN <%aE>%Creset

[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers

#[url "git@github.com:"]
#	insteadOf = https://github.com/
#	insteadOf = git://github.com/
#	insteadOf = gh:

[help]
	autocorrect = 10

[http]
	cookiefile = {{ .chezmoi.homeDir }}/.gitcookies

[include]
	path = .git.aliases
	path = .local.gitconfig

